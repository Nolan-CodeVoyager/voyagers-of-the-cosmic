# .gitignore — файлы, которые Git не должен отслеживать:
#   node_modules/ — ставится через npm install
#   .env — секреты (API-ключ NVIDIA)
#   служебные файлы ОС и логи

# Зависимости Node.js
node_modules/

# Секреты — никогда не коммитить!
.env
backend/.env

# Логи и временные файлы
*.log
.DS_Store
Thumbs.db
